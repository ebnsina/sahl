{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Sahl",
	"version": "0.1.0",
	"identifier": "me.ebnsina.sahl",
	"build": {
		"frontendDist": "../../apps/terminal/build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm --filter @sahl/terminal dev --port 5173 --strictPort",
		"beforeBuildCommand": "pnpm --filter @sahl/terminal build"
	},
	"app": {
		"windows": [
			{
				"title": "Sahl",
				"width": 1280,
				"height": 800,
				"minWidth": 1024,
				"minHeight": 640,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
		}
	},
	"bundle": {
		"active": false,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
		"publisher": "ebnsina",
		"copyright": "© 2026 ebnsina",
		"category": "Business",
		"shortDescription": "Offline-first point of sale",
		"longDescription": "Sahl is an offline-first point of sale for retail, café and grocery. The shop keeps selling when the internet does not, and every sale, shift and stock movement is recorded to a hash-chained log that syncs when the connection returns."
	}
}
