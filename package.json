{
	"name": "sahl",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev:terminal": "pnpm --filter @sahl/terminal dev",
		"dev:dashboard": "pnpm --filter @sahl/dashboard dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint",
		"format": "prettier --write .",
		"rs:fmt": "cargo fmt --all",
		"rs:lint": "cargo clippy --workspace --all-targets -- -D warnings",
		"rs:test": "cargo test --workspace",
		"till": "tauri dev --config crates/sahl-terminal/tauri.conf.json",
		"till:build": "tauri build --config crates/sahl-terminal/tauri.conf.json"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.4",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
