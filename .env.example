# Copy to .env and fill in. Every variable is REQUIRED — the server has no defaults and no silent
# fallbacks, and will refuse to start if any is missing or malformed.

# Must be a NOSUPERUSER NOBYPASSRLS role, or startup aborts.
# See crates/sahl-server/migrations/README.md.
DATABASE_URL=postgres://sahl_app:password@localhost:5432/sahl

SAHL_DB_MAX_CONNECTIONS=10
SAHL_BIND_ADDRESS=127.0.0.1:8080

# How long a device-enrollment token stays usable. It is a bearer credential an owner reads off a
# screen, so keep it short.
SAHL_ENROLLMENT_TOKEN_TTL_SECONDS=900

# Replay window for signed device requests. Shop terminals genuinely have bad clocks, so this cannot
# be seconds; it also cannot be hours, or a captured request stays usable all day. Max 3600.
SAHL_SIGNATURE_MAX_SKEW_SECONDS=300
