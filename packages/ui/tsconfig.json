{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"noEmit": true
	},
	// `scripts/` is deliberately excluded: fetch-fonts.mjs is a one-off Node build tool, not part of
	// the library surface, and type-checking it against DOM libs just demands @types/node for no gain.
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
